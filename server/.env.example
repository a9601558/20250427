# ============================================
# 【機密情報】バックエンド環境変数サンプル
# ============================================
# このファイルを .env にコピーして実際の値を設定してください
# ⚠️ .envファイルは絶対にGitにコミットしないでください

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Server Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
PORT=5000
NODE_ENV=development

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MySQL Database Configuration 🔒
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quizdb
DB_USER=root
DB_PASSWORD=your_secure_database_password
SYNC_DB=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# JWT Configuration 🔒
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 強力なランダム文字列を生成: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Stripe API Keys 🔒
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# テスト環境: pk_test_xxx / sk_test_xxx
# 本番環境: pk_live_xxx / sk_live_xxx
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Frontend URL (CORS設定用)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AWS Cognito Configuration 🔒
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 本番環境: ap-northeast-1 (東京リージョン)
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_06Lr5s5h9

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# セキュリティのベストプラクティス
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ✓ このファイル(.env.example)はGitにコミット可能
# ✗ 実際の.envファイルは絶対にコミットしない
# ✓ 本番環境では強力なパスワードを使用
# ✓ 定期的にシークレットキーをローテーション
# ✓ チーム共有時はこのexampleファイルを参照 