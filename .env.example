# ============================================
# フロントエンド環境変数サンプル
# ============================================
# このファイルを .env にコピーして使用してください
# 機密情報（DB、Stripe Secret等）は server/.env で管理

# API Base URL
VITE_API_BASE_URL=/api

# Stripe公開可能キー（フロントエンド用 - 公開しても安全）
VITE_STRIPE_PUBLIC_KEY=pk_test_your_public_key_here

# アプリケーション設定（オプション）
VITE_APP_NAME=MonTopi
VITE_APP_VERSION=1.0.0 