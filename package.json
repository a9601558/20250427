{
  "name": "socket-test",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "cd server && npm run build",
    "build:all": "npm run build && npm run build:server && mkdir -p dist/server && cp -r server/dist/* dist/server/",
    "preview": "vite preview",
    "start": "cd server && npm start",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.13.0",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.3.0",
    "antd": "^5.24.8",
    "aws-amplify": "^6.15.6",
    "axios": "^1.3.6",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.553.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-oidc-context": "^3.3.0",
    "react-router-dom": "^6.10.0",
    "react-spring": "^9.7.5",
    "react-toastify": "^9.1.2",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/date-fns": "^2.5.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "overrides": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "react-native": {
      "@types/react": "^18.3.24"
    },
    "@react-native/virtualized-lists": {
      "@types/react": "^18.3.24"
    }
  },
  "resolutions": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7"
  }
}
